    {
      "id": "mapa-sveta",
      "media": "2590e11524f1",
      "x": 1490.75,
      "y": 86.19,
      "w": 400,
      "rotation": 1.4,
      "plaqueAt": {
        "dx": 16.7,
        "dy": -351
      },
      "exhibit": {
        "slug": "worldmap",
        "inv": 18,
        "title": "World Map",
        "medium": "hand-painted on parchment",
        "description": "Founded in Edinburgh in the 19th century, the Scottish firm John Bartholomew and Co. practically held a monopoly on putting the world on paper. In the 1830s, they landed the contract to produce maps for the famous Encyclopedia Britannica, a gig they managed to keep for a solid ninety years. As the British Empire expanded abroad and education boomed at home, their atlases sold like hotcakes.\n\nWe actually have this family business to thank for the brilliant idea of coloring British territories bright red so everyone could immediately see who owned half the planet, as well as the use of color gradients to show elevation. Thanks to their innovations, you can now get lost in the mountains with much better style and a clear idea of how steep the climb is going to be.",
        "tags": [],
        "gallery": [],
        "plaque": true
      },
      "opening": {
        "shape": "rect",
        "x": 0.11,
        "y": 0.13,
        "w": 0.78,
        "h": 0.73
      }
    },
    {
      "id": "mapa-amerika",
      "media": "767c78e2f549",
      "x": -1198.91,
      "y": 1385.53,
      "w": 323.5,
      "rotation": -0.2,
      "plaqueAt": {
        "dx": -22.8,
        "dy": -354.9
      },
      "exhibit": {
        "slug": "lostmapofamerica",
        "inv": 17,
        "title": "Lost map of America",
        "medium": "hand-drawn on parchment",
        "description": "Compiled in 1513 by Ottoman admiral and cartographer Piri Reis, this legendary world map was proudly presented to Sultan Selim I right after the conquest of Egypt. What the ruler actually did with it remains a total mystery, as the map promptly vanished from history for centuries, seemingly tucked away in a very deep drawer.\n\nWhen the surviving one-third was finally rediscovered in 1929 at Istanbul's Topkapi Palace, it caused an international sensation. Experts realized that Piri Reis had copied a portion of an otherwise lost map drawn by Christopher Columbus himself. In short, you are looking at the most valuable and historic piece of copied homework in the history of navigation.",
        "tags": [],
        "gallery": [],
        "plaque": true
      },
      "opening": {
        "shape": "rect",
        "x": 0.1,
        "y": 0.07,
        "w": 0.79,
        "h": 0.86
      }
    },
    {
      "id": "certificat-of-forgery",
      "media": "6626420bc9e3",
      "x": -63.28,
      "y": -370.89,
      "w": 400,
      "rotation": 0,
      "plaqueAt": {
        "dx": 18.1,
        "dy": 1.4
      },
      "exhibit": {
        "slug": "certificate",
        "inv": 1,
        "title": "Proof on Paper",
        "medium": "",
        "description": "This distinguished university diploma belongs to an alumnus of Miskatonic University who also happens to be the proud owner of the entire private collection on display. Considering the sheer weirdness of everything else in the room, his academic background suddenly makes a lot of sense.\nBeing an alumnus of such a peculiar institution comes with a very specific kind of expertise that is best kept off your standard resume. Still, the owner displays this document with unmistakable pride, treating it like the highest possible honor for fooling history, collectors, and plain common sense all at once. Just take a closer look at what he actually majored in.",
        "tags": [],
        "gallery": [],
        "plaque": true
      },
      "opening": {
        "shape": "rect",
        "x": 0.09,
        "y": 0.11,
        "w": 0.81,
        "h": 0.77
      }
